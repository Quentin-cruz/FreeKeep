{
  "manifest_version": 3,
  "name": "FreeKeep<3",
  "short_name": "FreeKeep<3",
  "version": "1.8.1",
  "description": "Jeux PC offerts à garder (Epic, Steam, GOG, Prime…) + vraies grosses promos PC et Switch, à ta mesure.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FreeKeep<3",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://*.epicgames.com/*",
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://steamcommunity.com/*"
  ],
  "optional_host_permissions": [
    "https://www.gog.com/*",
    "https://catalog.gog.com/*",
    "https://store.ubisoft.com/*",
    "https://register.ubisoft.com/*",
    "https://www.ea.com/*",
    "https://*.itch.io/*",
    "https://itch.io/*",
    "https://www.indiegala.com/*",
    "https://freebies.indiegala.com/*",
    "https://www.cheapshark.com/*",
    "https://feed.eikowagenknecht.com/*",
    "https://www.ecb.europa.eu/*",
    "https://www.dealabs.com/*",
    "https://www.humblebundle.com/*",
    "https://www.fanatical.com/*",
    "https://www.greenmangamingbundles.com/*",
    "https://searching.nintendo-europe.com/*",
    "https://api.ec.nintendo.com/*",
    "https://www.nexarda.com/*",
    "https://www.eneba.com/*",
    "https://www.kinguin.net/*",
    "https://www.instant-gaming.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.epicgames.com/*",
        "https://www.epicgames.com/store/*",
        "https://store.steampowered.com/app/*"
      ],
      "js": [
        "content/claim.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
